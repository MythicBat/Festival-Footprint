{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Festivals by State (2016 - 2023)",
    "data": {"url": "data/festivals_by_state_year.csv"},
    "params": [
        {
            "name": "yr", "value": 2023, "bind": {"input": "range", "min": 2016, "max": 2023, "step": 1}
        },
        {"name": "uiState", "value": ""},
        {"name": "uiGenre", "value": ""}
    ],
    "transform": [
        {"filter": "datum.year == yr"},
        {"filter": "uiState == '' || datum.state == uiState"},
        {"filter": "uiGenre == '' || datum.genre == uiGenre"}
    ],
    "mark": { "type": "bar", "cornerRadiusEnd": 4},
    "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": "-x", "title": null},
        "x": {"field": "festival_count", "type": "quantitative", "title": "Festivals"},
        "color": {"field": "state", "type": "nominal", "scale": {"range": ["#56B4E9", "#E69F00", "#009E73", "#CC79A7", "#F0E442", "#0072B2", "#D55E00", "#999999"]},"legend": null},
        "tooltip": [
            {"field": "state"},
            {"field": "festival_count", "title": "Festivals"},
            {"field": "year"}
        ]
    },
    "width": 1100,
    "height": 420,
    "view": {"stroke": null}
}